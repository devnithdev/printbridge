{
  "name": "print-platform-agent",
  "version": "4.2.2",
  "private": true,
  "description": "PrintBridge printer agent (macOS, Windows, Linux)",
  "author": "Devnith AE",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "build:win": "pkg agent.js --config package.json --targets node16-win-x64 --output dist/PrintAgent.exe"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "lib/**/*.js"
    ],
    "assets": [
      "tools/SumatraPDF.exe"
    ]
  }
}
